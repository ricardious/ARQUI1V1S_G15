# ==========================================================
#  Invernadero Inteligente IoT — Grupo 15
#  .gitignore
# ==========================================================

# ----- Credenciales y entorno (NUNCA subir) -----
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
config.local.*
secrets.*

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
# Entornos virtuales
venv/
.venv/
env/
ENV/

# ----- ARM64 / Ensamblador -----
# Objetos y ejecutables compilados (el .s sí se sube)
*.o
*.out
*.elf
*.bin
a.out
# Dumps generados por QEMU/core dumps
*.core
core.*
qemu_*.core
# Shim local para depuracion (apunta al gdb del sistema)
arm64/utils/gdb-multiarch
# Salidas generadas en ejecución (regenerables)
# Descomentar si NO quieren versionar los resultados:
# resultado_*.txt
# resultados_arm64/
arm64/lecturas.csv
resultados_arm64/*.txt

# ----- Node.js / Dashboard web -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/

# ----- Logs y temporales -----
*.log
*.tmp
*.bak
*.swp

# ----- Editores e IDEs -----
.vscode/
.idea/
*.sublime-*

# ----- Sistema operativo -----
.DS_Store
Thumbs.db
desktop.ini
